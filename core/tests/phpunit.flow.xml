<?xml version="1.0" encoding="UTF-8"?>
<!--
    Config for the flow feature tests only.

    They need a real database, so they must never be pointed at the dev database: this
    file sends them to a throwaway clone instead (see tests/README.md for how to create
    and drop it). The shipped core/phpunit.xml is deliberately left alone so
    "php artisan test" keeps working out of the box.

    Run from core/:  ./vendor/bin/phpunit -c tests/phpunit.flow.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Flow">
            <directory>Feature/Flow</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../app/Lib/WhatsApp</directory>
            <directory>../app/Http/Controllers</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="product_ovowpp_test"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
